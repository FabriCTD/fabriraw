/* CTD Photo Studio — modo oscuro FabriCTD
   fondo #09080C · superficies #121117 / #1A1920 · borde #2E2D33
   texto #EDEBF0 / #A6A3AD · acento ámbar #F0B232 · verde #23A559 */

* {
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 10pt;
    color: #EDEBF0;
    outline: 0;
}

QMainWindow, QDialog, QWidget#central {
    background: #09080C;
}

QWidget { background: transparent; }

QToolTip {
    background: #1A1920;
    color: #EDEBF0;
    border: 1px solid #2E2D33;
    padding: 4px 6px;
}

/* ---- barra superior ---- */
QFrame#topbar {
    background: #121117;
    border-bottom: 1px solid #2E2D33;
}
QLabel#appTitle {
    font-size: 13pt;
    font-weight: 700;
    color: #EDEBF0;
}
QLabel#appSubtitle { color: #A6A3AD; font-size: 9pt; }
QLabel#dirtyBadge {
    color: #F0B232;
    font-weight: 600;
    border: 1px solid #F0B232;
    border-radius: 9px;
}
QLabel#savedBadge {
    color: #23A559;
    font-weight: 600;
    border: 1px solid #23A559;
    border-radius: 9px;
}

/* ---- botones ---- */
QPushButton, QToolButton {
    background: #1A1920;
    border: 1px solid #2E2D33;
    border-radius: 7px;
    padding: 6px 12px;
    color: #EDEBF0;
}
QPushButton:hover, QToolButton:hover { border-color: #F0B232; }
QPushButton:pressed, QToolButton:pressed { background: #23222A; }
QPushButton:checked, QToolButton:checked {
    border-color: #F0B232;
    color: #F0B232;
}
QPushButton:disabled, QToolButton:disabled { color: #5E5B66; border-color: #222128; }
QPushButton#primary {
    background: #F0B232;
    color: #09080C;
    border: 1px solid #F0B232;
    font-weight: 700;
}
QPushButton#primary:hover { background: #F5C45A; }
QPushButton#primary:disabled { background: #3A3320; color: #7A7060; border-color: #3A3320; }

/* ---- paneles ---- */
QFrame#panel {
    background: #121117;
    border: 1px solid #2E2D33;
    border-radius: 10px;
}
QLabel#panelTitle {
    color: #A6A3AD;
    font-size: 8.5pt;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
}
QLabel#muted { color: #A6A3AD; }
QLabel#metaValue { color: #EDEBF0; }
QLabel#sliderValue { color: #F0B232; font-family: "Cascadia Mono", "Consolas", monospace; }

QSplitter::handle { background: #09080C; }
QSplitter::handle:horizontal { width: 6px; }
QSplitter::handle:vertical { height: 6px; }

QScrollArea { border: none; background: transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }

QScrollBar:vertical { background: #121117; width: 10px; margin: 0; }
QScrollBar:horizontal { background: #121117; height: 10px; margin: 0; }
QScrollBar::handle { background: #2E2D33; border-radius: 4px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: #45434C; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

/* ---- listas (biblioteca, tira de frames) ---- */
QListWidget {
    background: #121117;
    border: none;
    padding: 4px;
}
QListWidget::item {
    color: #A6A3AD;
    border-radius: 8px;
    padding: 4px;
    margin: 2px;
}
QListWidget::item:hover { background: #1A1920; color: #EDEBF0; }
QListWidget::item:selected { background: #1A1920; color: #F0B232; border: 1px solid #F0B232; }

/* ---- sliders ---- */
QSlider::groove:horizontal {
    height: 4px;
    background: #2E2D33;
    border-radius: 2px;
}
QSlider::sub-page:horizontal { background: #F0B232; border-radius: 2px; }
QSlider::handle:horizontal {
    background: #EDEBF0;
    border: 2px solid #F0B232;
    width: 12px;
    height: 12px;
    margin: -6px 0;
    border-radius: 8px;
}
QSlider::handle:horizontal:hover { background: #F0B232; }
QSlider#centered::sub-page:horizontal { background: #2E2D33; }

/* ---- combos, spins, checks ---- */
QComboBox, QSpinBox, QDoubleSpinBox, QLineEdit {
    background: #1A1920;
    border: 1px solid #2E2D33;
    border-radius: 6px;
    padding: 4px 8px;
    min-height: 20px;
}
QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover, QLineEdit:focus { border-color: #F0B232; }
QComboBox::drop-down { border: none; width: 18px; }
QComboBox QAbstractItemView {
    background: #1A1920;
    border: 1px solid #2E2D33;
    selection-background-color: #2E2D33;
    selection-color: #F0B232;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 14px; height: 14px;
    border: 1px solid #45434C;
    background: #1A1920;
    border-radius: 3px;
}
QRadioButton::indicator { border-radius: 7px; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked { background: #F0B232; border-color: #F0B232; }

/* ---- menús ---- */
QMenuBar { background: #121117; border-bottom: 1px solid #2E2D33; }
QMenuBar::item { padding: 4px 10px; background: transparent; }
QMenuBar::item:selected { background: #1A1920; color: #F0B232; }
QMenu { background: #1A1920; border: 1px solid #2E2D33; padding: 4px; }
QMenu::item { padding: 6px 22px; border-radius: 5px; }
QMenu::item:selected { background: #2E2D33; color: #F0B232; }
QMenu::item:disabled { color: #5E5B66; }
QMenu::separator { height: 1px; background: #2E2D33; margin: 4px 8px; }

QStatusBar { background: #121117; color: #A6A3AD; border-top: 1px solid #2E2D33; }
QStatusBar QLabel { color: #A6A3AD; }

QProgressBar {
    background: #1A1920;
    border: 1px solid #2E2D33;
    border-radius: 6px;
    text-align: center;
    color: #EDEBF0;
}
QProgressBar::chunk { background: #F0B232; border-radius: 5px; }

QTextBrowser, QPlainTextEdit {
    background: #121117;
    border: 1px solid #2E2D33;
    border-radius: 8px;
    padding: 6px;
}
QMessageBox QLabel { color: #EDEBF0; }
QGroupBox { border: 1px solid #2E2D33; border-radius: 8px; margin-top: 12px; padding-top: 8px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; color: #A6A3AD; }

/* =====================================================================
   Interfaz de revelado profesional
   ===================================================================== */

/* ---- paneles acoplables ---- */
QMainWindow::separator { background: #09080C; width: 5px; height: 5px; }
QMainWindow::separator:hover { background: #2E2D33; }
QDockWidget { color: #A6A3AD; font-weight: 700; titlebar-close-icon: none; }
QDockWidget::title {
    background: #121117;
    border-bottom: 1px solid #2E2D33;
    padding: 6px 10px;
    text-align: left;
}
QDockWidget > QWidget { background: #121117; }
QDockWidget::close-button, QDockWidget::float-button {
    background: transparent; border: none; padding: 0; icon-size: 10px;
}
QDockWidget::close-button:hover, QDockWidget::float-button:hover { background: #2E2D33; border-radius: 3px; }
QTabBar::tab {
    background: #121117; color: #A6A3AD; padding: 5px 12px;
    border: 1px solid #2E2D33; border-bottom: none;
    border-top-left-radius: 6px; border-top-right-radius: 6px; margin-right: 2px;
}
QTabBar::tab:selected { background: #1A1920; color: #F0B232; }

/* ---- secciones del panel de revelado ---- */
QWidget#panelInner { background: transparent; }
QFrame#groupSection {
    background: #121117;
    border: 1px solid #23222A;
    border-radius: 9px;
}
QFrame#groupHeader { background: #17161D; border-radius: 9px; }
QPushButton#groupTitle {
    background: transparent; border: none; padding: 2px 2px;
    font-weight: 700; font-size: 10pt; color: #EDEBF0; text-align: left;
}
QPushButton#groupTitle:checked { color: #EDEBF0; border: none; }
QPushButton#groupTitle:pressed { background: transparent; }
QPushButton#groupTitle:hover { color: #F0B232; }
QPushButton#groupTitle[bypassed="true"] { color: #5E5B66; text-decoration: line-through; }
QToolButton#groupReset { padding: 1px 7px; border-radius: 6px; font-size: 11pt; }
QLabel#changedDot { color: #F0B232; font-size: 9pt; }
QWidget#groupBody { background: transparent; }
QLabel#sectionTitle {
    color: #6F6C78; font-size: 7.5pt; font-weight: 700; letter-spacing: 1px;
    padding: 6px 0 2px 0;
}
QLabel#paramLabel { color: #CFCCD6; }
QLabel#paramLabel[changed="true"] { color: #F0B232; }
QLabel#hint { color: #6F6C78; font-size: 8.5pt; }
QLabel#wheelTitle { color: #A6A3AD; font-weight: 600; font-size: 9pt; }
QLineEdit#valueField {
    background: #0E0D12; border: 1px solid #23222A; border-radius: 5px;
    padding: 1px 5px; min-height: 18px; color: #F0B232;
    font-family: "Cascadia Mono", "Consolas", monospace; font-size: 9pt;
}
QLineEdit#valueField:focus { border-color: #F0B232; background: #1A1920; }
QLineEdit#search { padding: 5px 10px; border-radius: 8px; }

QToolButton#segFirst, QToolButton#segMid, QToolButton#segLast {
    border-radius: 0; padding: 3px 6px; background: #1A1920; font-size: 9pt;
}
QToolButton#segFirst { border-top-left-radius: 6px; border-bottom-left-radius: 6px; }
QToolButton#segLast { border-top-right-radius: 6px; border-bottom-right-radius: 6px; }
QToolButton#segFirst:checked, QToolButton#segMid:checked, QToolButton#segLast:checked {
    background: #3A3320; color: #F0B232; border-color: #F0B232;
}
QTabBar#chanTabs::tab {
    background: #1A1920; color: #A6A3AD; padding: 3px 10px; margin-right: 2px;
    border: 1px solid #2E2D33; border-radius: 6px;
}
QTabBar#chanTabs::tab:selected { color: #09080C; background: #F0B232; border-color: #F0B232; }
QToolButton#cropTool:checked, QToolButton#targetTool:checked { background: #3A3320; }

/* ---- historial, presets, biblioteca ---- */
QTreeWidget, QListWidget#historyList, QTableWidget {
    background: #0E0D12; border: 1px solid #23222A; border-radius: 8px; padding: 3px;
    alternate-background-color: #121117;
}
QTreeWidget::item { padding: 3px 2px; border-radius: 5px; color: #CFCCD6; }
QTreeWidget::item:hover { background: #1A1920; color: #EDEBF0; }
QTreeWidget::item:selected { background: #2E2D33; color: #F0B232; }
QListWidget#historyList::item { padding: 3px 6px; margin: 0; border-radius: 5px; }
QListWidget#historyList::item:selected { background: #2E2D33; color: #F0B232; border: none; }
QLabel#presetPreview {
    background: #0E0D12; border: 1px dashed #2E2D33; border-radius: 8px; color: #6F6C78; padding: 4px;
}
QListWidget#filmstrip { background: #0E0D12; border-radius: 8px; }
QHeaderView::section { background: #1A1920; color: #A6A3AD; border: none; padding: 4px 6px; }
QTableWidget { gridline-color: #23222A; }
QPushButton#chip { padding: 2px 8px; border-radius: 9px; font-size: 8.5pt; }

/* ---- barra de estado ---- */
QLabel#rgbReadout { color: #EDEBF0; font-family: "Cascadia Mono", "Consolas", monospace; padding-right: 10px; }
QLabel#shotInfo { color: #A6A3AD; font-size: 9pt; }

QMainWindow > QTabBar { background: #09080C; }
QMainWindow > QTabBar::tab { background: #121117; color: #A6A3AD; border: 1px solid #2E2D33; border-top: none;
    border-radius: 0; border-bottom-left-radius: 6px; border-bottom-right-radius: 6px; padding: 4px 12px; }
QMainWindow > QTabBar::tab:selected { color: #F0B232; background: #1A1920; }
QToolButton#iconBtn { font-size: 14pt; padding: 0 8px; }
